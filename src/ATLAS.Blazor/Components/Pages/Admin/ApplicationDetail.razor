@page "/admin/applications/{ApplicationId:guid}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ATLAS.Blazor.Components.Shared.Admin

<PageTitle>Application Detail</PageTitle>

<div class="container mt-4">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin">Administration</a></li>
            <li class="breadcrumb-item"><a href="/admin/applications">Applications</a></li>
            <li class="breadcrumb-item active" aria-current="page">Application Detail</li>
        </ol>
    </nav>

    <PageHeader Title="Application Detail"
                Description="Application details are coming in a future milestone. This page is a placeholder." />

    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">Application Detail</h4>
        <p>
            The application detail view for administrators is under development.
            You are viewing application <strong>@ApplicationId</strong>.
        </p>
        <hr />
        <a href="/admin/applications" class="btn btn-outline-primary">Back to Application Explorer</a>
    </div>
</div>

@code {
    [Parameter]
    public Guid ApplicationId { get; set; }
}